# The payment provider the merchant talks to. The local stand-in listens on 5001; a real provider's test-mode API
# address goes here with its test keys. Use test keys only; the program refuses a live key (sk_live_, pk_live_).
PROVIDER_BASE_URL=http://127.0.0.1:5001
# What the customer's browser uses to reach the provider, when it differs from the server-side address (in Docker).
PROVIDER_PUBLIC_URL=http://127.0.0.1:5001
PROVIDER_SECRET_KEY=sk_test_local_standin_0001
PROVIDER_PUBLISHABLE_KEY=pk_test_local_standin_0001
# Signs the webhooks the provider sends to the merchant. Set a long random value anywhere real.
WEBHOOK_SECRET=whsec_local_standin_change_me_before_sharing_0001
# The merchant's own address, used in the page's content security policy and the provider's webhook target.
MERCHANT_BASE_URL=http://127.0.0.1:5000
# The deliberately naive checkout, run only to be measured.
NAIVE_BASE_URL=http://127.0.0.1:5002
# Where the merchant keeps orders (tokens only) and where the "before" app logs.
DATABASE_PATH=state/merchant.db
NAIVE_LOG_PATH=state/naive/requests.log
STATE_DIR=state
EVIDENCE_DIR=evidence
LOG_LEVEL=INFO
